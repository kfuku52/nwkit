+
+
+def _joint_information_criterion(data, result, criterion):
+    if criterion == "pBIC":
+        raise ValueError(
+            "Joint covariance pBIC is not implemented; use AIC, AICc, BIC or bootstrap."
+        )
+    joint = result["joint_covariance"]
+    means = len(data.trait_names) * len(result["layout"].groups)
+    parameters = (
+        len(result["layout"].shifts)
+        + means
+        + joint["covariance_parameter_count"]
+        + joint["alpha_parameter_count"]
+        + joint["measurement_parameter_count"]
+    )
+    n = int(np.any(np.isfinite(data.values), axis=1).sum())
+    penalty = parameters * (math.log(n) if criterion == "BIC" else 2)
+    extra = 0.0
+    if criterion == "AICc":
+        if n <= parameters + 1:
+            return {
+                "criterion": criterion,
+                "score": None,
+                "penalty": None,
+                "parameter_count": parameters,
+                "sample_size": n,
+                "status": "insufficient_aicc_sample_size",
+            }
+        extra = 2 * parameters * (parameters + 1) / (n - parameters - 1)
+    return {
+        "criterion": criterion,
+        "score": -2 * result["log_likelihood"] + penalty + extra,
+        "penalty": penalty + extra,
+        "parameter_count": parameters,
+        "sample_size": n,
+        "small_sample_correction": extra if criterion == "AICc" else None,
+        "status": "ok",
+        "sample_size_convention": "observed_tip_vectors",
+        "calibration": "heuristic_information_criterion; not_a_calibrated_shift_test",
+    }
