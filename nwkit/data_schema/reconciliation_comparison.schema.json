{
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "mode",
    "panels",
    "shared_context",
    "view"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "reconciliation_comparison"
    },
    "mode": {
      "enum": [
        "general",
        "inferred_trees",
        "fixed_gene_tree"
      ]
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "document",
          "document_sha256",
          "inference_status",
          "history_status",
          "inference_runtime",
          "history_runtime"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "inference_status": {
            "enum": [
              "success",
              "partial",
              "failed",
              "timeout",
              "missing",
              "not_applicable"
            ]
          },
          "history_status": {
            "enum": [
              "available",
              "partial",
              "failed",
              "timeout",
              "missing",
              "unsupported"
            ]
          },
          "inference_runtime": {
            "type": "object",
            "required": [
              "seconds",
              "measured_at",
              "conditions"
            ],
            "properties": {
              "seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "measured_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conditions": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "history_runtime": {
            "type": "object",
            "required": [
              "seconds",
              "measured_at",
              "conditions"
            ],
            "properties": {
              "seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "measured_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conditions": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "annotations": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "history_status": {
                  "enum": [
                    "available",
                    "partial"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "document": {
                  "type": "string",
                  "minLength": 1
                },
                "document_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "shared_context": {
      "type": "object",
      "required": [
        "upper_tree_sha256",
        "gene_tree_sha256",
        "mapping_sha256"
      ],
      "properties": {
        "upper_tree_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "gene_tree_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "mapping_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "layout"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "reconciliation_view"
        },
        "layout": {
          "enum": [
            "standalone",
            "topology_embedded",
            "paired"
          ]
        },
        "leaf_order": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "collapsed_clades": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tree",
              "node"
            ],
            "properties": {
              "tree": {
                "type": "string",
                "minLength": 1
              },
              "node": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "event_colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "font": {
          "type": "object",
          "required": [
            "family",
            "size"
          ],
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 72
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "enum": [
                "pdf",
                "svg",
                "png",
                "html"
              ]
            },
            "pdf_pages": {
              "enum": [
                "auto",
                "single",
                "tiled"
              ]
            },
            "pdf_page_size": {
              "enum": [
                "A4",
                "A3"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:reconciliation-view:0.1.0",
      "description": "Reserved N3/N4 contract. This configuration is not yet executable by nwkit draw."
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reconciliation-comparison:0.1.0",
  "description": "Reserved N3/N4 contract. This configuration is not yet executable by nwkit draw."
}
